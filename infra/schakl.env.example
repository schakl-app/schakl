# Environment for infra/compose.swarm.yml.
#
#   cp infra/schakl.env.example ./schakl.env && chmod 600 ./schakl.env   # then fill in
#   set -a; . ./schakl.env; set +a
#   docker stack deploy -c infra/compose.swarm.yml schakl
#
# `docker stack deploy` performs interpolation from the SHELL environment and, unlike
# `docker compose`, does not read a .env file on its own — hence the `set -a` sourcing.

# --- Release ---------------------------------------------------------------------------
# Pin a real tag. `latest` makes a rollback ambiguous and a redeploy non-reproducible.
SCHAKL_TAG=

# --- Identity --------------------------------------------------------------------------
SCHAKL_BASE_DOMAIN=schakl.cloud
# openssl rand -hex 32   — forgeable sessions and a decryptable secret vault if weak.
SCHAKL_SECRET_KEY=

# --- Managed Postgres (Scaleway) ---------------------------------------------------------
# Must NOT be a SUPERUSER or a BYPASSRLS role: tenant isolation is enforced by RLS policies.
PGHOST=172.16.8.3
PGPORT=5432
PGDATABASE=rdb
PGUSER=
PGPASSWORD=

# --- Object storage (Scaleway nl-ams) ------------------------------------------------------
SCHAKL_STORAGE_S3_ENDPOINT=https://s3.nl-ams.scw.cloud
SCHAKL_STORAGE_S3_REGION=nl-ams
SCHAKL_STORAGE_S3_BUCKET=schakl-cloud
SCHAKL_STORAGE_S3_ACCESS_KEY_ID=
SCHAKL_STORAGE_S3_SECRET_ACCESS_KEY=
# Applied on read, write and delete — changing it later strands existing objects.
SCHAKL_STORAGE_S3_KEY_PREFIX=prod

# --- Ingress ---------------------------------------------------------------------------
# Host directory your traefik stack bind-mounts at /configuration/.
TRAEFIK_CONFIG_DIR=/opt/traefik/config
SCHAKL_CLOUD_INGRESS_DIR=/configuration
# The CNAME target you hand customers; give this name an A/AAAA record to the server.
SCHAKL_CLOUD_CNAME_TARGET=edge.schakl.cloud

# --- Cloudflare for SaaS -------------------------------------------------------------------
# Scoped ZONE token, on ONE zone, with exactly two permissions:
#   Zone -> SSL and Certificates -> Edit   (custom hostnames)
#   Zone -> DNS -> Edit                    (the per-org <slug>.<base_domain> record)
# Nothing account-level, never a Global API Key. Prefer the _FILE form with a Docker secret so
# the value is not visible in `docker inspect`.
SCHAKL_CLOUD_CF_API_TOKEN=
# SCHAKL_CLOUD_CF_API_TOKEN_FILE=/run/secrets/cf_token
SCHAKL_CLOUD_CF_ZONE_ID=
# Leave this EMPTY unless your zone is Enterprise. Cloudflare already presents the custom origin
# server (the CNAME target above) as SNI, which is what your wildcard origin cert covers; an
# explicit SNI rewrite is an Enterprise-only entitlement and setting it on Free/Pro/Business makes
# every custom-hostname create fail. Empty means the field is not sent at all.
SCHAKL_CLOUD_CF_ORIGIN_SNI=

# --- Plans -----------------------------------------------------------------------------
SCHAKL_CLOUD_TRIAL_DAYS=14
SCHAKL_CLOUD_SERVICE_PIN_HOURS=24

# --- Per-org end date and termination ------------------------------------------------------
# An org's ends_at is NULL (unlimited) unless someone sets one, so this is inert by default.
# Deploy ENABLED=true with DESTRUCTIVE=false first: real warnings and suspensions, and
# terminations that stop after archiving, while everything is still recoverable.
SCHAKL_CLOUD_GRACE_DAYS=14
SCHAKL_CLOUD_RETENTION_DAYS=30
SCHAKL_CLOUD_LIFECYCLE_ENABLED=false
SCHAKL_CLOUD_LIFECYCLE_DESTRUCTIVE=false
SCHAKL_CLOUD_LIFECYCLE_BATCH=25

# --- Optional: instance-provided e-mail --------------------------------------------------
SCHAKL_INSTANCE_EMAIL_ENABLED=false
SCHAKL_INSTANCE_EMAIL_FROM=
SCHAKL_INSTANCE_EMAIL_FROM_NAME=
SCHAKL_INSTANCE_EMAIL_HOST=
SCHAKL_INSTANCE_EMAIL_PORT=587
SCHAKL_INSTANCE_EMAIL_SECURITY=starttls
SCHAKL_INSTANCE_EMAIL_USERNAME=
SCHAKL_INSTANCE_EMAIL_PASSWORD=

---
// The landing page is a list of CMS-managed blocks (hero, feature grid, text+bullets,
// CTA band) — add, remove or reorder sections in Keystatic without touching code.
import SiteShell from './SiteShell.astro';
import Showcase from './showcase/Showcase.astro';
import Icon from './showcase/Icon.astro';
import DemoButton from './DemoButton.astro';
import settings from '../data/settings/site.json';
import landing from '../data/landing.json';
import IntegrationMark from './integrations/IntegrationMark.astro';
import { integrations as allIntegrations, statusLabel } from '../lib/integrations.ts';
import { localizeHref } from '../lib/links';

interface Props {
  locale: 'nl' | 'en';
}
const { locale } = Astro.props;
// One CMS entry holds both locales (Sveltia single_file i18n structure).
const { blocks } = landing[locale];

// Feature cards are their own Keystatic collection; the `features` block places the grid.
const featureModules = import.meta.glob('../data/features/*.json', { eager: true });
const features = Object.values(featureModules)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => a.order - b.order);

const href = (h: string) => localizeHref(locale, h);
// When a demo URL is configured, the live-demo button becomes the hero's primary CTA and the
// CMS primary (usually the docs) steps down to a bordered button.
const hasDemo = Boolean((settings as any).demo?.url?.trim());

const hero: any = blocks.find((b: any) => b.type === 'hero');
const title = hero ? `${settings.brandName} · ${hero.title}` : settings.brandName;
---

<SiteShell locale={locale} title={title} description={hero?.subtitle}>
  {
    blocks.map((v: any) => {
      const id = v.anchor || undefined;
      switch (v.type) {
        case 'hero':
          return (
            <section class="hero container">
              <p class="eyebrow">{v.eyebrow}</p>
              <h1>{v.title}</h1>
              <p class="subtitle">{v.subtitle}</p>
              <div class="cta-row">
                <DemoButton locale={locale} variant="button" />
                <a class={`button ${hasDemo ? '' : 'primary'}`} href={href(v.ctaPrimary.href)}>{v.ctaPrimary.label}</a>
                <a class="button" href={href(v.ctaSecondary.href)}>{v.ctaSecondary.label}</a>
              </div>
            </section>
          );
        case 'features':
          return (
            <section id={id} class="container features">
              <div data-reveal>
                <h2>{v.title}</h2>
                <p class="section-intro">{v.intro}</p>
              </div>
              <div class="feature-grid">
                {features.map((f: any, n: number) => (
                  <a
                    class="feature-card"
                    href={href(`/features/${f.slug}`)}
                    data-reveal
                    style={`--reveal-delay:${Math.min(n, 8) * 45}ms`}
                  >
                    <span class="feature-icon"><Icon name={f.lucide} size={1.4} /></span>
                    <h3>{f.title[locale]}</h3>
                    <p>{f.description[locale]}</p>
                    <span class="feature-more" aria-hidden="true">
                      <Icon name="arrowRight" size={0.95} />
                    </span>
                  </a>
                ))}
              </div>
            </section>
          );
        case 'textBullets':
          return (
            <section id={id} class="selfhost">
              <div class="container selfhost-grid">
                <div data-reveal>
                  <h2>{v.title}</h2>
                  <p class="section-intro">{v.body}</p>
                </div>
                <ul class="check-list" data-reveal style="--reveal-delay:120ms">
                  {v.bullets.map((b: string) => <li>{b}</li>)}
                </ul>
              </div>
            </section>
          );
        case 'showcase':
          return (
            <Showcase
              locale={locale}
              anchor={v.anchor || undefined}
              title={v.title}
              intro={v.intro}
              items={v.items}
            />
          );
        case 'integrations': {
          // The strip names the services an agency already pays for, so the block picks them by
          // slug from the CMS list rather than repeating their names as copy — one place to
          // rename Mollie, and the badge cannot drift from the integrations page.
          const picked = (v.slugs ?? [])
            .map((s: string) => allIntegrations.find((i: any) => i.slug === s))
            .filter(Boolean);
          return (
            <section id={id} class="ixstrip">
              <div class="container">
                <div class="ixstrip__head" data-reveal>
                  <h2>{v.title}</h2>
                  <p class="section-intro">{v.intro}</p>
                </div>
                <div class="ixstrip__grid">
                  {picked.map((i: any, n: number) => (
                    <a
                      class="ixstrip__item"
                      href={href(`/integrations/${i.slug}`)}
                      data-reveal
                      style={`--reveal-delay:${Math.min(n, 6) * 55}ms`}
                    >
                      <IntegrationMark
                        slug={i.slug}
                        monogram={i.mark?.monogram ?? i.name.charAt(0)}
                        color={i.mark?.color}
                        lucide={i.lucide}
                        size={2.5}
                      />
                      <span class="ixstrip__name">{i.name}</span>
                      <span class="ixstrip__tag">{i.tagline?.[locale]}</span>
                      {i.status !== 'live' && (
                        <span class="ixstrip__badge">{statusLabel[i.status]?.[locale]}</span>
                      )}
                    </a>
                  ))}
                </div>
                <a class="ixstrip__all" href={href('/integrations/')} data-reveal>
                  {v.label}
                  <Icon name="arrowRight" size={0.95} />
                </a>
              </div>
            </section>
          );
        }
        case 'cta':
          return (
            <section id={id} class="container docs-cta" data-reveal>
              <h2>{v.title}</h2>
              <p class="section-intro">{v.body}</p>
              <a class="button primary" href={href(v.href)}>{v.label}</a>
            </section>
          );
      }
    })
  }
</SiteShell>

<style>
  .ixstrip {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
    padding-block: 3.5rem;
  }
  .ixstrip__head {
    max-width: 42rem;
    margin-bottom: 2rem;
  }
  .ixstrip__head h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }
  .ixstrip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.75rem;
  }
  .ixstrip__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.1rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    background: var(--bg);
    color: var(--text);
    transition:
      border-color 0.18s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ixstrip__item:hover {
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ixstrip__item:hover {
      transform: translateY(-2px);
    }
  }
  .ixstrip__item :global(.mark) {
    margin-bottom: 0.6rem;
  }
  .ixstrip__name {
    font-weight: 620;
    font-size: 0.98rem;
  }
  .ixstrip__tag {
    color: var(--muted);
    font-size: 0.84rem;
  }
  .ixstrip__badge {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 650;
  }
  .ixstrip__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    color: var(--accent);
    font-weight: 600;
  }
  .ixstrip__all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

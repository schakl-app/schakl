---
// The tile that stands for a vendor.
//
// It draws the vendor's actual brand mark where one exists (src/lib/brand-marks.ts, generated
// from Simple Icons) and falls back to a monogram where none does — Mollie, OXXA, Exact Online,
// SnelStart and SE Ranking have no CC0 mark, and redrawing a logo everybody recognises looks
// worse than not having one. That fallback is why the mark is drawn as a single path in the
// vendor's own brand colour inside the tile rather than as a full-colour logo on a white chip:
// a set of full-colour logos at five aspect ratios beside five monograms reads as broken, while
// one tinted tile per vendor reads as a system that happens to know some logos better than
// others. It also means one path serves light and dark themes, with no second asset per vendor.
//
// The colour is decorative; the name is always in text beside it, so the tile is aria-hidden and
// carries nothing a screen reader would miss.
import Icon from '../showcase/Icon.astro';
import { brandMarks } from '../../lib/brand-marks';

// Vendor-supplied logos (src/assets/brands/<slug>.svg) win over the generated set: a file put
// there came from the vendor's own brand kit, which beats a community redraw. They are inlined
// rather than <img>-ed so they cost no request and can inherit currentColor where they are
// monochrome. Anything full-colour keeps its own fills and simply ignores the tint.
const vendorLogos = import.meta.glob('../../assets/brands/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const vendorLogoBySlug: Record<string, string> = Object.fromEntries(
  Object.entries(vendorLogos).map(([p, svg]) => [p.split('/').pop()!.replace(/\.svg$/, ''), svg]),
);

// A vendor who only publishes a raster gets one too. These are app-icon shaped — the mark on the
// vendor's own background, edge to edge — so they fill the tile and are clipped by its radius
// rather than floated inside it on a tint that would fight the icon's own background.
const vendorRasters = import.meta.glob('../../assets/brands/*.{png,webp,jpg,jpeg}', {
  import: 'default',
  eager: true,
}) as Record<string, { src: string } | string>;

const vendorRasterBySlug: Record<string, string> = Object.fromEntries(
  Object.entries(vendorRasters).map(([p, asset]) => [
    p.split('/').pop()!.replace(/\.(png|webp|jpe?g)$/, ''),
    typeof asset === 'string' ? asset : asset.src,
  ]),
);

interface Props {
  /** Integration slug — the key into the brand-mark set. Absent or unknown ⇒ monogram. */
  slug?: string;
  monogram: string;
  color?: string;
  lucide?: string;
  /** Tile size in rem. */
  size?: number;
  class?: string;
}
const { slug, monogram, color, lucide, size = 3, class: cls = '' } = Astro.props;

// No brand colour on the card falls back to the site accent, so a new integration added in the
// CMS without one still looks deliberate rather than grey.
const tint = color || 'var(--accent)';
const vendorLogo = slug ? vendorLogoBySlug[slug] : undefined;
const vendorRaster = slug && !vendorLogo ? vendorRasterBySlug[slug] : undefined;
const path = slug ? brandMarks[slug] : undefined;
---

<span
  class={`mark ${vendorRaster ? 'mark--raster' : ''} ${cls}`}
  style={`--mark-color:${tint};--mark-size:${size}rem`}
  aria-hidden="true"
>
  {
    vendorRaster ? (
      <img class="mark__raster" src={vendorRaster} alt="" loading="lazy" decoding="async" />
    ) : vendorLogo ? (
      <span class="mark__vendor" set:html={vendorLogo} />
    ) : path ? (
      <svg class="mark__logo" viewBox="0 0 24 24" fill="currentColor" focusable="false">
        <path d={path} />
      </svg>
    ) : (
      <span class="mark__mono">{monogram}</span>
    )
  }
  {lucide && (
    <span class="mark__glyph"><Icon name={lucide} size={0.85} stroke={2.4} /></span>
  )}
</span>

<style>
  .mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    border-radius: calc(var(--mark-size) * 0.26);
    background: color-mix(in srgb, var(--mark-color) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--mark-color) 30%, transparent);
    color: var(--mark-color);
    /* The tint is mixed against the page, which is near-black in dark mode, so a saturated
       brand colour stays legible in both themes without a second value per vendor. */
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      background 0.25s ease;
  }
  .mark__logo {
    /* Slightly smaller than the monogram's optical size: a logo fills its 24×24 box edge to
       edge, where a letterform carries its own side bearings. Matching them by font-size would
       leave the logos looking oversized next to the monograms they sit beside. */
    width: calc(var(--mark-size) * 0.5);
    height: calc(var(--mark-size) * 0.5);
    display: block;
  }
  /* An app-icon raster brings its own background, so the tile drops its tint and becomes a
     frame: the border stays, because a white-backed icon on a light page needs one edge. */
  .mark--raster {
    background: none;
    overflow: hidden;
  }
  .mark__raster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* A vendor file carries its own aspect ratio, so it is fitted to a box rather than given a
     fixed square: preserveAspectRatio contains it, and a wide mark uses the extra width instead
     of being squeezed into the height a square glyph would take. */
  .mark__vendor {
    display: block;
    width: calc(var(--mark-size) * 0.62);
    height: calc(var(--mark-size) * 0.62);
  }
  .mark__vendor :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .mark__mono {
    font-weight: 750;
    font-size: calc(var(--mark-size) * 0.42);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .mark__glyph {
    position: absolute;
    right: calc(var(--mark-size) * -0.09);
    bottom: calc(var(--mark-size) * -0.09);
    display: grid;
    place-items: center;
    width: calc(var(--mark-size) * 0.42);
    height: calc(var(--mark-size) * 0.42);
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>

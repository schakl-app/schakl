---
// The tile that stands in for a vendor logo.
//
// Deliberately NOT the vendor's own logo: we do not ship their trademarks, and a redrawn
// approximation of a mark everybody recognises looks worse than not having one. So each card
// gets a monogram tile tinted with the vendor's own brand colour plus the category glyph —
// recognisable at a glance, correct by construction, and one static file with no image requests.
//
// The colour is decorative only; the name is always in text beside it, so nothing here carries
// meaning a screen reader would miss.
import Icon from '../showcase/Icon.astro';

interface Props {
  monogram: string;
  color?: string;
  lucide?: string;
  /** Tile size in rem. */
  size?: number;
  class?: string;
}
const { monogram, color, lucide, size = 3, class: cls = '' } = Astro.props;

// No brand colour on the card falls back to the site accent, so a new integration added in the
// CMS without one still looks deliberate rather than grey.
const tint = color || 'var(--accent)';
---

<span
  class={`mark ${cls}`}
  style={`--mark-color:${tint};--mark-size:${size}rem`}
  aria-hidden="true"
>
  <span class="mark__mono">{monogram}</span>
  {lucide && (
    <span class="mark__glyph"><Icon name={lucide} size={0.85} stroke={2.4} /></span>
  )}
</span>

<style>
  .mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    border-radius: calc(var(--mark-size) * 0.26);
    background: color-mix(in srgb, var(--mark-color) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--mark-color) 30%, transparent);
    color: var(--mark-color);
    /* The tint is mixed against the page, which is near-black in dark mode, so a saturated
       brand colour stays legible in both themes without a second value per vendor. */
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      background 0.25s ease;
  }
  .mark__mono {
    font-weight: 750;
    font-size: calc(var(--mark-size) * 0.42);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .mark__glyph {
    position: absolute;
    right: calc(var(--mark-size) * -0.09);
    bottom: calc(var(--mark-size) * -0.09);
    display: grid;
    place-items: center;
    width: calc(var(--mark-size) * 0.42);
    height: calc(var(--mark-size) * 0.42);
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>

---
// The site chrome — header, footer, head — shared by the landing page and every
// CMS-created page. Branding (logo, colors, nav, footer) comes from the Keystatic
// settings singleton.
import settings from '../data/settings/site.json';
import { localizeHref, altHref } from '../lib/links';
import MegaMenu from './MegaMenu.astro';
import DemoButton from './DemoButton.astro';
import MobileMenu from './MobileMenu.astro';
import LangSwitcher from './LangSwitcher.astro';
import '../styles/landing.css';

interface Props {
  locale: 'nl' | 'en';
  title: string;
  description?: string;
}
const { locale, title, description } = Astro.props;

// hreflang alternates: English is the root, Dutch is under /nl. x-default points at English.
const enAlt = altHref(Astro.url.pathname, 'en');
const nlAlt = altHref(Astro.url.pathname, 'nl');

// The logos are CMS-managed: Keystatic writes files into src/assets/site/ and stores their
// paths in the settings singleton. Resolve through Vite so the build fingerprints them.
// A dark variant exists because an <img> cannot inherit currentColor from the page.
const logoModules = import.meta.glob('/src/assets/site/*', { eager: true });
const resolveLogo = (p?: string) => (p ? (logoModules[p] as any)?.default?.src : undefined);
const logoSrc: string | undefined = resolveLogo(settings.logo);
const logoDarkSrc: string | undefined = resolveLogo((settings as any).logoDark);

const href = (h: string) => localizeHref(locale, h);

const themeCss = `:root{--brand-accent:${settings.colors.accent};--brand-accent-dark:${settings.colors.accentDark};}`;

// Route visitors landing on the homepage to their browser language (English is the root, Dutch
// is /nl); a stored choice from the switcher always wins. Only the homepage auto-routes, so a
// shared deep link keeps its explicit locale. Runs in <head> before render to avoid a flash.
const autoRouteScript = `(function(){try{var p=location.pathname;var enHome=p==='/';var nlHome=p==='/nl'||p==='/nl/';if(!enHome&&!nlHome)return;var s=null;try{s=localStorage.getItem('schakl:lang')}catch(e){}var pn=(navigator.languages||[navigator.language||'']).some(function(l){return l.toLowerCase().indexOf('nl')===0});var w=s||(pn?'nl':'en');if(w==='nl'&&enHome){location.replace('/nl/'+location.search+location.hash)}else if(w==='en'&&nlHome){location.replace('/'+location.search+location.hash)}}catch(e){}})();`;

// Marks the document as scripted, in <head>, before the first paint. The scroll-reveal styles
// hang off this class so a reader with JavaScript off is never served an invisible page — the
// hidden start state simply never applies, and every section is there on load.
const hasJsScript = `document.documentElement.classList.add('has-js');`;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={settings.favicon} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL(enAlt, Astro.site)} />
    <link rel="alternate" hreflang="nl" href={new URL(nlAlt, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enAlt, Astro.site)} />
    <script is:inline set:html={hasJsScript} />
    <script is:inline set:html={autoRouteScript} />
    <style set:html={themeCss}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={href('/')}>
          {logoSrc ? (
            <picture>
              {logoDarkSrc && <source media="(prefers-color-scheme: dark)" srcset={logoDarkSrc} />}
              <img src={logoSrc} alt={settings.brandName} height="28" />
            </picture>
          ) : (
            settings.brandName
          )}
        </a>
        <nav class="site-nav" aria-label={locale === 'nl' ? 'Hoofdnavigatie' : 'Main navigation'}>
          <MegaMenu locale={locale} />
          {settings.nav
            .filter((item) => item.href !== '/#features')
            .map((item) => <a href={href(item.href)}>{item[locale]}</a>)}
          <DemoButton locale={locale} variant="header" />
          <LangSwitcher locale={locale} />
        </nav>
        <MobileMenu locale={locale} />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <div>
          <span class="brand">{settings.brandName}</span>
          <p class="footer-note">{settings.footerNote[locale]}</p>
        </div>
        <nav aria-label="Footer">
          {settings.footerLinks.map((item) => <a href={href(item.href)}>{item[locale]}</a>)}
        </nav>
      </div>
      <div class="container footer-credit">
        <p>
          <span>{locale === 'nl'
            ? 'Gebruikt en gemaakt met open-source liefde'
            : 'Used and made with open-source love'}</span>
          <svg class="footer-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
            ></path>
          </svg>
          <span>{locale === 'nl' ? 'door' : 'by'}</span>
          <a class="footer-breik" href="https://www.breik.nl" target="_blank" rel="noopener"
            >[b]reik.</a
          >
        </p>
      </div>
    </footer>

    <script>
      // Reveal on scroll. One observer for the whole page; each element unobserves itself the
      // moment it lands, so a long page costs nothing after the first pass. Anything already
      // in view when the script runs is revealed immediately rather than waiting for a scroll
      // that may never come — a visitor who lands mid-page must not meet a blank screen.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (!targets.length) {
        // nothing to do
      } else if (reduce.matches || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          // A little below the fold, so the transition has finished by the time the element
          // is properly in the reader's eye rather than starting under their nose.
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
        // Flipping reduced-motion on mid-session must not strand whatever is still hidden.
        reduce.addEventListener('change', (ev) => {
          if (!ev.matches) return;
          io.disconnect();
          targets.forEach((el) => el.classList.add('is-in'));
        });
      }
    </script>
  </body>
</html>
